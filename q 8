#include <iostream>
using namespace std;

void diagonalSum(int a[10][10], int n)
{
    int sum = 0;

    for (int i = 0; i < n; i++)
    {
        sum = sum + a[i][i];
    }

    cout << "Sum of diagonal elements: " << sum;
}

int main()
{
    int a[10][10], n;

    cout << "Enter matrix size: ";
    cin >> n;

    cout << "Enter matrix elements:\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> a[i][j];
        }
    }

    diagonalSum(a, n);

    return 0;
}
