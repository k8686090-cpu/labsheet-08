#include <iostream>
#include <cstring>
using namespace std;

void copyString(char str1[], char str2[])
{
    strcpy(str2, str1);
}

int main()
{
    char str1[100], str2[100];

    cout << "Enter a string: ";
    cin.getline(str1, 100);

    copyString(str1, str2);

    cout << "Original String: " << str1 << endl;
    cout << "Copied String: " << str2;

    return 0;
}
