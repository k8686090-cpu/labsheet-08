#include <iostream>
using namespace std;

class Shape
{
public:
    virtual void area() = 0;
};

class Circle : public Shape
{
    float radius;

public:
    void input()
    {
        cout << "Enter radius of circle: ";
        cin >> radius;
    }

    void area()
    {
        cout << "Area of Circle: "
             << 3.14 * radius * radius << endl;
    }
};

class Rectangle : public Shape
{
    float length, breadth;

public:
    void input()
    {
        cout << "Enter length: ";
        cin >> length;

        cout << "Enter breadth: ";
        cin >> breadth;
    }

    void area()
    {
        cout << "Area of Rectangle: "
             << length * breadth << endl;
    }
};

int main()
{
    Circle c;
    Rectangle r;

    cout << "Circle Details:\n";
    c.input();
    c.area();

    cout << "\nRectangle Details:\n";
    r.input();
    r.area();

    return 0;
}
